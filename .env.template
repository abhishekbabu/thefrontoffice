# Copy to .env and fill in. Nothing here is synced between machines: paste the
# four secrets from your password manager on each new one, then run
# `just doctor` to confirm the file is complete and free of typos — a mistyped
# key is ignored silently rather than reported.

# Yahoo Developer App credentials
# Get these from: https://developer.yahoo.com/apps/
# Set your Redirect URI to: https://localhost:8080
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here

# AI — optional, and any one key is enough. With several, each backs up the
# one before when its quota runs out: Gemini, then Groq, then OpenRouter. All
# three are free to start.
# Gemini:     https://aistudio.google.com/app/apikey
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/settings/keys
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Sleeper (fantasy football) — no API key or OAuth; the username is only used
# to find your leagues. Leave blank if you only use the NBA features.
SLEEPER_USERNAME=your_sleeper_username

# Fantasy Premier League — no API key or OAuth. FPL has no public username
# lookup, so this is the entry id: the number in the URL of your own points
# page, https://fantasy.premierleague.com/entry/<THIS>/event/1
FPL_ENTRY_ID=your_fpl_entry_id

# Pydantic Logfire (optional tracing). Create a project at
# https://logfire.pydantic.dev and copy a *write* token. Without one the
# instrumentation stays inert: nothing is exported and no network call is made.
LOGFIRE_TOKEN=

# Optional Settings — all validated at startup by config/settings.py. Every one
# below already has this value as its default, so leave them commented unless
# you are changing one; `just doctor` prints what is actually in effect.
# YAHOO_MAX_WEEKLY_ADDS=3     # Max player adds per week (int >= 0, default: 3)
# LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
# LOGFIRE_ENVIRONMENT=local   # Separates traces per machine in one Logfire project
# LOGFIRE_CAPTURE_PROMPTS=false  # Sends prompt TEXT to Logfire. Off deliberately.
# YAHOO_CACHE_DIR=.yahoo_cache      # Where cached Yahoo responses live
# SLEEPER_CACHE_DIR=.sleeper_cache  # Where cached Sleeper responses live
# FPL_CACHE_DIR=.fpl_cache          # Where cached FPL responses live
# ESPN_CACHE_DIR=.espn_cache        # Where cached ESPN news lives
# ANSWER_CACHE_DIR=.answer_cache      # Every kept model answer
# GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b      # Groq's model for reports
# GROQ_PARSING_MODEL=openai/gpt-oss-20b        # Groq's model for parsing
# OPENROUTER_ANALYSIS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_PARSING_MODEL=nvidia/nemotron-3-super-120b-a12b:free
