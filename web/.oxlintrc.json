{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Lint rules for the front end. Deliberately short: `tsc` already rejects
  // unused variables, bad imports and wrong types, and the production build a
  // Tailwind class that resolves to nothing. Every rule past Oxlint's
  // correctness set is here because something actually went wrong.
  "plugins": ["typescript", "react", "oxc", "vitest"],
  "categories": { "correctness": "error" },
  // Type-aware rules and the type check itself, both through `tsrs`: the same
  // diagnostics `tsc -b` gave, from the program the rules already built, so
  // there is no separate `tsc` pass anywhere (`just check-web`, `pnpm build`).
  "options": { "typeAware": true, "typeCheck": true },
  // `lint/anti-slop/` is vendored upstream source (its README: copied, not installed).
  "ignorePatterns": ["dist/**", ".shots/**", "scripts/**", "src/lib/schema.ts", "lint/anti-slop/**"],
  "jsPlugins": [
    "./lint/front-office.ts",
    { "name": "landmines", "specifier": "@interfere/landmines" },
    { "name": "anti-slop", "specifier": "./lint/anti-slop/index.ts" }
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // A component declared inside another is a new function every render, so
    // React sees a new element type and remounts the subtree. A `Shell` inside
    // `App` once meant every panel refetched and lost its scroll position
    // whenever anything above it changed, and nothing failed.
    "react/static-components": "error",
    // The React Compiler's own checks are in Oxlint's react correctness set
    // too: `refs`, `set-state-in-effect`, `purity` and the rest.

    "front-office/semantic-color": "error",
    "front-office/no-native-title": "error",

    // `m` components carry no animation code of their own; the feature set
    // arrives in a second chunk after first paint. Importing `motion` itself,
    // or a feature bundle, pulls the whole library into the entry bundle,
    // which is what the build's bundle budget (vite.config.ts) counts.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "motion/react",
            "importNames": ["motion", "domAnimation", "domMax"],
            "message": "Use `m` with LazyMotion, or the whole library lands in the entry bundle."
          }
        ]
      }
    ],

    // Type-aware: the promise and `any` mistakes tsc lets through.
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",

    // Every landmines rule (https://github.com/interfere-inc/landmines) but two
    // that contradict this repo: `no-comments` (rationale lives beside the code
    // here, not only in the PR) and `no-explicit-return-types`.
    "landmines/colocated-tests": "error",
    "landmines/declared-test-inputs": "error",
    // `lib/types.ts` names each generated API type once, one alias a line:
    // a facade over `schema.ts`, not a module mixing jobs. Held at its size, so
    // it can only shrink.
    "landmines/max-exports-per-module": ["error", { "allow": { "src/lib/types.ts": 46 } }],
    "landmines/max-file-lines": "error",
    "landmines/max-files-per-directory": "error",
    "landmines/no-clipboard-read-text": "error",
    "landmines/no-cold-import-in-test": "error",
    "landmines/no-cold-start-in-test": "error",
    "landmines/no-conditional-expect": "error",
    "landmines/no-elapsed-time-bound": "error",
    "landmines/no-fixed-sleep": "error",
    "landmines/no-flake-masking": "error",
    "landmines/no-github-scripts": "error",
    "landmines/no-imported-mutation": "error",
    "landmines/no-inline-hex-encoding": "error",
    "landmines/no-parameter-branch": "error",
    "landmines/no-prefix-cluster": "error",
    "landmines/no-project-max-workers": "error",
    "landmines/no-scripts-directory": "error",
    "landmines/no-self-container-query": "error",
    "landmines/no-shared-signal": "error",
    "landmines/no-silent-catch": "error",
    "landmines/no-stale-render-assertion": "error",
    "landmines/no-styling-class-assertion": "error",
    "landmines/no-test-doubles": "error",
    "landmines/no-unsignaled-poll": "error",
    "landmines/package-exports": "error",
    "landmines/package-scripts": "error",
    "landmines/padding-between-statements": "error",
    "landmines/strict-msw": "error",
    "landmines/test-dir-only-cross-functional": "error",
    "landmines/test-file-names": "error",

    // anti-slop (https://github.com/dmmulroy/anti-slop), every generic rule.
    // `typeof` stays allowed inside a type guard: guards are how this client
    // parses at its boundary, with no schema library.
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      // The rule's own tests hold the very strings it exists to reject.
      "files": ["lint/*.test.ts"],
      "rules": { "front-office/semantic-color": "off" }
    },
    {
      "files": ["src/lib/motion/features.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
